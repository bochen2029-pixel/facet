#include <windows.h>

1 RT_MANIFEST "facet.manifest"
1 ICON "facet.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Bo Chen"
      VALUE "FileDescription", "facet - pivot filtering over Everything's index"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "facet"
      VALUE "LegalCopyright", "MIT (c) 2026 Bo Chen"
      VALUE "OriginalFilename", "facet.exe"
      VALUE "ProductName", "facet"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
